# WEEK 6 .dockerignore
# Everything listed here stays out of the Docker build context.

# Version control and CI
.git/
.github/

# Local Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets
.env

# Build output from the Week 5 packaging step
dist/

# Development-only files: the image runs the app, it does not test or document it
tests/
docs/
student-resources/
